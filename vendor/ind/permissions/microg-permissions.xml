<?xml version="1.0" encoding="utf-8"?>
<!-- ==============================================================================
     Ind OS — Sandboxed microG Whitelisted Permissions
     Enables restricted signature spoofing solely for GmsCore / FakeStore.
     PRD Reference: v1.0.1-BIBLE (Phase 6, Sprint 17)
     ============================================================================== -->
<permissions>
    <!-- Allow Google Play Services stub to spoof signature for Play Integrity -->
    <privapp-permissions package="com.google.android.gms">
        <permission name="android.permission.FAKE_PACKAGE_SIGNATURE"/>
        <permission name="android.permission.ACCESS_NETWORK_STATE"/>
        <permission name="android.permission.CHANGE_NETWORK_STATE"/>
        <permission name="android.permission.INTERNET"/>
        <permission name="android.permission.WAKE_LOCK"/>
        <permission name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    </privapp-permissions>

    <!-- Allow FakeStore stub -->
    <privapp-permissions package="com.android.vending">
        <permission name="android.permission.FAKE_PACKAGE_SIGNATURE"/>
        <permission name="android.permission.CHECK_LICENSE"/>
    </privapp-permissions>
</permissions>
