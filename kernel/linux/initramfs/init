#!/bin/sh
# Ind OS Minimal Initramfs Init Script (Stage A Bootstrap)
# Boots directly to a DRM/KMS Wayland Compositor & Touchscreen Test Client
# Zero Android Userspace.

export PATH=/bin:/sbin

echo "=================================================="
echo " Starting Ind OS Mainline Linux Kernel Substrate "
echo " Hardware: Motorola Moto G60 (Qualcomm SM7150-AC) "
echo " Stage: Phase K0, Sprint 23 Mainline Baseline     "
echo "=================================================="

# 1. Mount virtual pseudo filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

# 2. Check DRM display & Touch devices
echo "[INIT] Probing display drm /dev/dri/card0..."
if [ -e /dev/dri/card0 ]; then
    echo "[INIT] DRM display initialized: Novatek NT36672C (120Hz 1080x2460)"
else
    echo "[INIT] Initializing fallback framebuffer console /dev/fb0..."
fi

echo "[INIT] Probing input touchscreen /dev/input/event0..."
if [ -e /dev/input/event0 ]; then
    echo "[INIT] Touchscreen controller initialized: FocalTech FT8756"
fi

# 3. Launch Wayland Surface Client
echo "[INIT] Starting minimal DRM Wayland surface compositor..."
/bin/ind_wayland_test_client &

# 4. Interactive rescue shell or idle loop
exec /bin/sh
