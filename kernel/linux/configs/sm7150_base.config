# Ind OS Mainline Linux Kernel Configuration Fragment
# Target: SM7150-AC / Motorola Moto G60 (hanoip)

# Arch & CPU (Qualcomm Kryo 470 / Cortex-A76 + Cortex-A55)
CONFIG_ARCH_QCOM=y
CONFIG_ARM64=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# DRM / Display Subsystem
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_PANEL_NOVATEK_NT36672C=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# Input & Touchscreen
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y

# TEE / OP-TEE Substrate (Phase K0 Sprint 27 Foundation)
CONFIG_TEE=y
CONFIG_OPTEE=y
CONFIG_OPTEE_SHM_NUM_PRIV_PAGES=8192
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_OPTEE=y

# Memory Management & DMA-BUF
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# Extensible Scheduler & BPF for AI Workload Priority (Sprint 39)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_SCHED_CLASS_EXT=y
