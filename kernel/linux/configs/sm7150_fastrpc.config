# Ind OS Mainline Linux Kernel Configuration Fragment — Hexagon DSP & FastRPC
# Target: SM7150-AC / Qualcomm Hexagon 692 (Sprint 25)

# Qualcomm Remote Processor Messaging & Subsystems
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_ADSP=m
CONFIG_QCOM_Q6V5_WCSS=m
CONFIG_QCOM_SYSMON=m

# Qualcomm Inter-Processor Communication (IPCC) & Shared Memory (SMEM)
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_GLINK=y
CONFIG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_GLINK_SSR=y

# Qualcomm FastRPC (Mainline Drivers / Remote Procedure Calls to CDSP & ADSP)
CONFIG_QCOM_FASTRPC=m
CONFIG_QCOM_APR=m

# SMMU v2 / ARM SMMU for Hexagon DMA Buffer Isolation (FS-D9 Requirement)
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_IO_PGTABLE_ARMV7S=y
CONFIG_IOMMU_IO_PGTABLE_LPAE=y
