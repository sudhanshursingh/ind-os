# Ind OS Mainline Linux Kernel Configuration Fragment — Radio, Audio, Power & Thermal
# Target: SM7150-AC / Motorola Moto G60 (hanoip) (Sprint 24)

# Wireless & Networking (Ath10k / Qualcomm WCN3990)
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_QUALCOMM=y
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_ATH10K_DEBUG=n
CONFIG_CFG80211=m
CONFIG_RFKILL=y

# ASoC Audio (Qualcomm WCD937x / WSA881x / LPASS DSP audio)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_SM7150=y
CONFIG_SND_SOC_WCD937X=y
CONFIG_SND_SOC_WCD937X_SDW=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_QDSP6_AFE=y
CONFIG_SND_SOC_QDSP6_ADM=y
CONFIG_SND_SOC_QDSP6_ASM=y
CONFIG_SND_DYNAMIC_MINORS=y

# Power Management & Regulators (PM6150 / PM6150L)
CONFIG_PM=y
CONFIG_PM_AUTOSUSPEND=y
CONFIG_SUSPEND=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y

# Thermal Management & Sensors
CONFIG_THERMAL=y
CONFIG_THERMAL_STATISTICS=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=0
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_CPU_THERMAL=y

# Battery & Fuel Gauge (PM6150 SMB1390 / FG)
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_QPNP_FG_GEN4=y
CONFIG_QPNP_SMB1390=y
