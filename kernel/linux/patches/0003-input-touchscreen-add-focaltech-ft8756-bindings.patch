From 3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d Mon Sep 17 00:00:00 2001
From: Ind OS Kernel Team <kernel@indos.dev>
Date: Mon, 26 Oct 2026 07:10:00 +0530
Subject: [PATCH 3/4] input: touchscreen: add FocalTech FT8756 bindings

Adds device tree match table entry for the FocalTech FT8756 touchscreen
controller used on Motorola Moto G60.

Signed-off-by: Ind OS Kernel Team <kernel@indos.dev>
---
 drivers/input/touchscreen/focaltech_touch.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/input/touchscreen/focaltech_touch.c b/drivers/input/touchscreen/focaltech_touch.c
index 4a5b6c7..7d8e9f0 100644
--- a/drivers/input/touchscreen/focaltech_touch.c
+++ b/drivers/input/touchscreen/focaltech_touch.c
@@ -210,6 +210,12 @@ static const struct of_device_id fts_match_table[] = {
+	{ .compatible = "focaltech,fts8756" },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, fts_match_table);
-- 
