{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indos.dev/schemas/intent-v1.json",
  "title": "IndOSIntentEnvelope",
  "description": "Standard Intent ABI v1.0 Declaration Envelope for Ind OS Semantic Gateway",
  "type": "object",
  "required": ["intent_id", "timestamp_ms", "session_id", "declared_tier", "actions"],
  "properties": {
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "declared_tier": {
      "type": "string",
      "enum": ["GREEN", "AMBER", "RED"]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["action_type", "target", "params", "data_taint_labels", "required_capabilities"],
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "SYS_TOGGLE",
              "OPEN_APP",
              "CLICK_NODE",
              "INPUT_TEXT",
              "SCROLL",
              "READ_SCREEN",
              "PLACE_CALL",
              "SEND_MESSAGE",
              "PAYMENT_INTENT"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "params": {
            "type": "object"
          },
          "data_taint_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "USER_VOICE",
                "SYSTEM_STATE",
                "BANKING_SMS",
                "UNTRUSTED_SCREEN_TEXT",
                "UNTRUSTED_WEB_CONTENT",
                "UNTRUSTED_SMS"
              ]
            }
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^cap:[a-z0-9_.-]+$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "user_feedback": {
      "type": "object",
      "properties": {
        "tts_text": {
          "type": "string",
          "maxLength": 1024
        },
        "visual_state": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
