// ==============================================================================
// Ind OS — Neural Core Streaming Callback Contract
// Subsystem: ind-neural-core / Layer 4 Privileged Service
// BIBLE v1.0.1 (Amendment A-001)
// ==============================================================================

package indos.neural.ipc;

interface IIndStreamCallback {
    /** Streaming token generated by the on-device LLM sampler. */
    void onToken(in String token);

    /** Final deterministic GBNF action JSON payload. */
    void onActionResolved(in String actionJson);

    /** Engine or execution error notification. */
    void onError(int errorCode, in String message);
}
