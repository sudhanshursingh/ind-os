<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Privileged Permissions whitelisted in vendor/ind/permissions/privapp-permissions-ind.xml -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:label="Ind Neural Core"
        android:persistent="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- Core Privileged AI IPC Service -->
        <service
            android:name="indos.neural.IndAIService"
            android:exported="true"
            android:process="indos.neural.daemon">
            <intent-filter>
                <action android:name="indos.neural.ipc.IIndAIManager" />
            </intent-filter>
        </service>

        <!-- Privileged Hardware & Settings Test Service for Sprint 1 DoD Verification -->
        <service
            android:name="indos.neural.IndSystemPrivilegeTestService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="indos.neural.ACTION_TEST_TOGGLE" />
            </intent-filter>
        </service>

    </application>
</manifest>
