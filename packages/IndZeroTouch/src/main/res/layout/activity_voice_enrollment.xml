<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#121212">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Ind OS Voice Biometrics"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enroll your voice for secure, hands-free unlock"
        android:textColor="#A0A0A0"
        android:textSize="14sp" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarEnrollment"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="28dp"
        android:max="4"
        android:progress="1"
        android:progressTint="#00E676" />

    <TextView
        android:id="@+id/tvStepIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Phrase 1 of 4"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Prompt Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Say this phrase aloud:"
            android:textColor="#888888"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPromptPhrase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hey Ind"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPhraseTranslation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="हे इंद"
            android:textColor="#B0B0B0"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Audio Visualizer / Status -->
    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Tap 'Speak Phrase' to record"
        android:textColor="#00E676"
        android:textSize="16sp" />

    <!-- Record Action Button -->
    <Button
        android:id="@+id/btnRecordPhrase"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#00E676"
        android:text="Speak Phrase"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRetryPhrase"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#333333"
        android:text="Retry Phrase"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <!-- Success Message Card -->
    <TextView
        android:id="@+id/tvEnrollmentComplete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Voice profile enrolled and encrypted successfully!"
        android:textColor="#00E676"
        android:textSize="15sp"
        android:visibility="gone" />

</LinearLayout>
