<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="false"
        android:label="Ind Zero-Touch"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- Privileged Accessibility Service for live UI semantic graph traversal & gesture dispatch -->
        <service
            android:name="indos.zerotouch.IndAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Continuous Low-Power Wake-Word & ECAPA-TDNN Biometric Verification Service -->
        <service
            android:name="indos.zerotouch.audio.AudioRingBufferService"
            android:exported="true"
            android:foregroundServiceType="microphone">
            <intent-filter>
                <action android:name="indos.zerotouch.action.START_LISTENING" />
                <action android:name="indos.zerotouch.action.STOP_LISTENING" />
                <action android:name="indos.zerotouch.action.SIMULATE_WAKE" />
            </intent-filter>
        </service>

        <!-- 4-Phrase Voice Biometrics Enrollment Wizard -->
        <activity
            android:name="indos.zerotouch.ui.VoiceEnrollmentActivity"
            android:exported="true"
            android:label="Voice Biometrics Enrollment"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="indos.zerotouch.action.ENROLL_VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Voice Orb Floating Window Overlay Service (TYPE_APPLICATION_OVERLAY) -->
        <service
            android:name="indos.zerotouch.ui.IndOrbOverlayService"
            android:exported="true">
            <intent-filter>
                <action android:name="indos.zerotouch.action.SHOW_ORB" />
                <action android:name="indos.zerotouch.action.HIDE_ORB" />
                <action android:name="indos.zerotouch.action.SET_ORB_STATE" />
                <action android:name="indos.zerotouch.action.SET_ORB_AMPLITUDE" />
            </intent-filter>
        </service>

    </application>
</manifest>
